{
  "color": {
    "$description": "Candidato C, UI-NPA-006. Neutro Institucional. Não homologado. Aliases exclusivos para primitivos.",
    "surface": {
      "canvas": { "$type": "color", "$value": "{color.stone.25}" },
      "raised": { "$type": "color", "$value": "{color.neutral.0}" },
      "sunken": { "$type": "color", "$value": "{color.stone.50}" },
      "overlay": { "$type": "color", "$value": "{color.scrim.light}" },
      "inverse": { "$type": "color", "$value": "{color.stone.900}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.stone.900}" },
      "secondary": { "$type": "color", "$value": "{color.stone.600}" },
      "disabled": { "$type": "color", "$value": "{color.stone.400}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.0}" },
      "brand": { "$type": "color", "$value": "{color.steel.700}" },
      "danger": { "$type": "color", "$value": "{color.red.700}" },
      "success": { "$type": "color", "$value": "{color.green.700}" },
      "warning": { "$type": "color", "$value": "{color.amber.700}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.stone.400}" },
