    },
    "blue": {
      "50": { "$type": "color", "$value": "#f1f6fb" },
      "100": { "$type": "color", "$value": "#e1ebf6" },
      "200": { "$type": "color", "$value": "#c3d6ec" },
      "300": { "$type": "color", "$value": "#93b4d8" },
      "400": { "$type": "color", "$value": "#5d8cba" },
      "500": { "$type": "color", "$value": "#3c6fa3" },
      "600": { "$type": "color", "$value": "#2f5884" },
      "700": { "$type": "color", "$value": "#244668" },
      "800": { "$type": "color", "$value": "#1c3752" },
      "900": { "$type": "color", "$value": "#14283c" }
    },
    "green": {
      "50": { "$type": "color", "$value": "#e8f6ef" },
      "100": { "$type": "color", "$value": "#b7e4cf" },
      "200": { "$type": "color", "$value": "#b7e0cb" },
      "700": { "$type": "color", "$value": "#0e6b45" }
    },
    "amber": {
      "50": { "$type": "color", "$value": "#fff8eb" },
      "100": { "$type": "color", "$value": "#f6d7a2" },
      "200": { "$type": "color", "$value": "#f0d7a2" },
      "700": { "$type": "color", "$value": "#6d4500" }
    },
    "red": {
      "50": { "$type": "color", "$value": "#fdeceb" },
      "100": { "$type": "color", "$value": "#f3d2cf" },
      "200": { "$type": "color", "$value": "#f5c2bc" },
      "700": { "$type": "color", "$value": "#8e1b14" },
      "800": { "$type": "color", "$value": "#6f150f" }
    },
    "scrim": {
      "light": { "$type": "color", "$value": "#171b2680" },
      "dark": { "$type": "color", "$value": "#00000099" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["system-ui", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
      }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" },
      "xl": { "$type": "dimension", "$value": "1.5rem" },
      "display": { "$type": "dimension", "$value": "1.75rem" },
      "2xl": { "$type": "dimension", "$value": "2rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "line": {
      "tight": { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "0.125rem" },
    "md": { "$type": "dimension", "$value": "0.25rem" },
    "lg": { "$type": "dimension", "$value": "0.5rem" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "width": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "focus": { "$type": "dimension", "$value": "2px" }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "#171b2614",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "#171b261f",
        "offsetX": "0",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0"
      }
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "180ms" }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "size": {
    "sidebar": {
      "expanded": { "$type": "dimension", "$value": "15rem" },
      "collapsed": { "$type": "dimension", "$value": "4rem" },
      "gutter": { "$type": "dimension", "$value": "3rem" }
    },
    "header": { "$type": "dimension", "$value": "3.5rem" },
    "institution": { "$type": "dimension", "$value": "4rem" },
    "control": {
      "sm": { "$type": "dimension", "$value": "2rem" },
      "md": { "$type": "dimension", "$value": "2.25rem" }
    },
    "content": {
      "max": { "$type": "dimension", "$value": "96rem" }
    },
    "field": {
      "max": { "$type": "dimension", "$value": "32rem" }
    },
    "grid": {
      "min": { "$type": "dimension", "$value": "14rem" }
    },
    "icon": { "$type": "dimension", "$value": "1.25rem" },
    "logo": {
      "sm": { "$type": "dimension", "$value": "2rem" },
      "md": { "$type": "dimension", "$value": "2.5rem" },
      "max": { "$type": "dimension", "$value": "7.5rem" }
    },
    "table": {
      "min": { "$type": "dimension", "$value": "40rem" }
    }
  },
  "z": {
    "sticky": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 20 },
    "sidebar": { "$type": "number", "$value": 30 },
    "header": { "$type": "number", "$value": 40 },
    "skip": { "$type": "number", "$value": 50 }
  }
}
